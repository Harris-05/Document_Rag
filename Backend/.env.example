# Where the SQLite database and uploaded originals are stored.
DATA_DIR=./data
# Largest accepted upload, in megabytes.
MAX_UPLOAD_MB=25
# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000
# Documents with fewer meaningful characters than this are rejected as having no readable text.
MIN_TEXT_CHARS=25

# AI provider (any OpenAI-compatible endpoint). Never commit your real key.
OPENAI_API_KEY=
# Leave empty for OpenAI itself, or set e.g. https://openrouter.ai/api/v1
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Most search-grade-refine rounds the agent may run for one question.
MAX_RETRIEVAL_ROUNDS=3

# Short-term memory: how many earlier question/answer exchanges the assistant remembers.
# 0 disables memory so every question stands alone. Maximum 20.
CHAT_MEMORY_TURNS=6
# Earlier answers are shortened to this many characters before the model sees them.
CHAT_MEMORY_CHARS=800

# Sampling temperature per stage (0 = most literal, higher = more varied). Models that only accept
# their default temperature are detected automatically and called without one.
TEMPERATURE_PLAN=0.3
TEMPERATURE_JUDGE=0.1
TEMPERATURE_ANSWER=0.4

# Passages judged per search round, and how many the answer may use.
CANDIDATES_PER_ROUND=14
MAX_EVIDENCE_PASSAGES=10
# Chunks of surrounding text added on each side of a strongly relevant passage (0 turns it off).
NEIGHBOR_CHUNKS=1
